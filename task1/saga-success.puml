@startuml saga-success
title Saga оформления заказа - успешный сценарий

participant "Order Service" as order
participant "Message Broker" as broker
participant "Inventory Service" as inventory
participant "Payment Service" as payment
participant "Delivery Service" as delivery
participant "Notification Service" as notification

order -> broker : OrderCreated
broker -> inventory : OrderCreated
broker -> notification : OrderCreated

activate inventory
inventory -> inventory : Проверка наличия\nи резервирование товаров
inventory -> broker : InventoryReserved
deactivate inventory

broker -> payment : InventoryReserved

activate payment
payment -> payment : Списание средств
payment -> broker : PaymentSucceeded
deactivate payment

broker -> order : PaymentSucceeded
broker -> delivery : PaymentSucceeded

activate delivery
delivery -> delivery : Создание заявки\nна доставку
delivery -> broker : DeliveryRequested
deactivate delivery

broker -> order : DeliveryRequested
broker -> notification : DeliveryRequested

activate order
order -> order : Подтверждение заказа
order -> broker : OrderConfirmed
deactivate order

broker -> notification : OrderConfirmed

@enduml
